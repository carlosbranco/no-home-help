{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nohomehelp.com/schemas/city.schema.json",
  "title": "No Home Help city guide",
  "type": "object",
  "required": ["$schema", "schema_version", "status", "locale", "location", "seo", "page", "quick_actions", "categories"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "status": { "enum": ["published", "draft"] },
    "locale": {
      "type": "object",
      "required": ["language", "direction", "primary"],
      "properties": {
        "language": {
          "type": "string",
          "description": "BCP 47 language tag used by the HTML lang and hreflang attributes.",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "direction": { "enum": ["ltr", "rtl"] },
        "primary": {
          "type": "boolean",
          "description": "True only for the city's local-language file. Translations use false and a language suffix in the filename."
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["continent", "country_code", "country_name", "country_local_name", "country_slug", "region_code", "region_name", "region_slug", "city_name", "city_slug"],
      "properties": {
        "continent": { "type": "string", "minLength": 1 },
        "country_code": { "type": "string", "minLength": 2 },
        "country_name": { "type": "string", "minLength": 1 },
        "country_local_name": { "type": "string", "minLength": 1 },
        "country_slug": { "$ref": "#/$defs/slug" },
        "region_code": { "type": "string" },
        "region_name": { "type": "string", "minLength": 1 },
        "region_slug": { "$ref": "#/$defs/slug" },
        "city_name": { "type": "string", "minLength": 1 },
        "city_slug": { "$ref": "#/$defs/slug" }
      },
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["heading", "last_verified", "urgent", "notice", "intro", "footer"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "last_verified": { "$ref": "#/$defs/date" },
        "urgent": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "notice": { "$ref": "#/$defs/inline" },
        "intro": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "footer": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": false
    },
    "quick_actions": {
      "type": "object",
      "description": "Explicit links to the most useful entries for each time horizon. References use category and entry IDs, so translated titles may change safely.",
      "required": ["tonight", "this_week", "this_month"],
      "properties": {
        "tonight": { "$ref": "#/$defs/actionReferences" },
        "this_week": { "$ref": "#/$defs/actionReferences" },
        "this_month": { "$ref": "#/$defs/actionReferences" }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/block" },
                { "$ref": "#/$defs/resource" }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "actionReference": {
      "type": "object",
      "required": ["category_id", "entry_id"],
      "properties": {
        "category_id": { "$ref": "#/$defs/slug" },
        "entry_id": { "$ref": "#/$defs/slug" }
      },
      "additionalProperties": false
    },
    "actionReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionReference" },
      "uniqueItems": true
    },
    "segment": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "href": { "type": "string" },
        "strong": { "type": "boolean" },
        "emphasis": { "type": "boolean" },
        "break": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "inline": {
      "description": "Use a plain string for ordinary text. Use an array of segments only when links, emphasis, bold text, or line breaks are needed.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/segment" } }
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "content"],
          "properties": {
            "type": { "enum": ["paragraph", "address"] },
            "content": { "$ref": "#/$defs/inline" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "enum": ["list", "ordered-list"] },
            "items": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "resource": {
      "type": "object",
      "required": ["type", "id", "name", "last_verified", "blocks"],
      "properties": {
        "type": { "const": "resource" },
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "last_verified": { "$ref": "#/$defs/date" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": false
    }
  }
}
