{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nohomehelp.com/schemas/city.schema.json",
  "title": "No Home Help city guide",
  "type": "object",
  "required": ["$schema", "documentation", "schema_version", "status", "locale", "location", "seo", "page", "categories"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "documentation": {
      "type": "string",
      "description": "Human-readable instructions for filling and editing a city JSON file."
    },
    "schema_version": { "const": 2 },
    "status": { "enum": ["published", "draft"] },
    "locale": {
      "type": "object",
      "required": ["language", "direction", "primary"],
      "properties": {
        "language": {
          "type": "string",
          "description": "BCP 47 language tag used by the HTML lang and hreflang attributes.",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "direction": { "enum": ["ltr", "rtl"] },
        "primary": {
          "type": "boolean",
          "description": "True only for the city's local-language file. Translations use false and a language suffix in the filename."
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["continent", "country_code", "country_name", "country_local_name", "country_slug", "region_code", "region_name", "region_slug", "city_name", "city_slug"],
      "properties": {
        "continent": { "type": "string", "minLength": 1 },
        "country_code": { "type": "string", "minLength": 2 },
        "country_name": { "type": "string", "minLength": 1 },
        "country_local_name": { "type": "string", "minLength": 1 },
        "country_slug": { "$ref": "#/$defs/slug" },
        "region_code": { "type": "string" },
        "region_name": { "type": "string", "minLength": 1 },
        "region_slug": { "$ref": "#/$defs/slug" },
        "city_name": { "type": "string", "minLength": 1 },
        "city_slug": { "$ref": "#/$defs/slug" }
      },
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["heading", "last_verified", "urgent", "notice", "intro", "footer"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "last_verified": { "$ref": "#/$defs/date" },
        "urgent": { "type": "string" },
        "notice": { "type": "string" },
        "intro": { "type": "string" },
        "footer": { "type": "string" }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "category": {
      "type": "object",
      "required": ["id", "title", "entries"],
      "properties": {
        "id": {
          "enum": [
            "emergency",
            "shelter",
            "food",
            "community",
            "hygiene",
            "clothing",
            "health",
            "mental-health",
            "public-facilities",
            "phone-internet",
            "transport",
            "benefits",
            "employment",
            "legal",
            "documents",
            "mail",
            "storage",
            "safety",
            "specialist-support",
            "veterans",
            "pets",
            "other"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "title", "description", "last_verified", "address", "phone", "website", "hours", "how_to_access"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "last_verified": { "$ref": "#/$defs/date" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "website": {
          "oneOf": [
            { "const": "" },
            { "type": "string", "format": "uri", "pattern": "^https?://" }
          ]
        },
        "hours": { "type": "string" },
        "how_to_access": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
